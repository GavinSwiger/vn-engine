define hana = Character("Hana")
default persistent.festivals = 0
default persistent.hana_remembers = False

label start:
    "The lanterns rise over the river."
    $ persistent.festivals += 1
    hana "Every year, the same lanterns."
    jump bridge

label bridge:
    if persistent.hana_remembers:
        hana "Have we... done this before?"
    hana "Which ending will it be?"
    menu:
        "Sad ending":
            $ persistent.hana_remembers = True
            "Hana walks away alone."
        "Lantern ending":
            "Hana smiles under the lanterns."
    return
