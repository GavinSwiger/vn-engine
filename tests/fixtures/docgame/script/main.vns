# F45 TR-F45-01's test game: each StatementDoc example is placed in this file, top-level
# examples above the first line, the others right after "label start:". turns is the
# minigame example's into target (F23); hana_here and answer are the file examples' (F31).
# cg festival is the gallery examples' picture, and cg river the declaration example's
# (F34; the scene keeps its dev load free of W226).
include "chapter2.vns"
define hana = Character("Hana")
default coins = 0
default turns = 0
default hana_here = True
default answer = None
points friendship 0 to 10
lock route river "By the River"
lock tip lanterns "Paper Lanterns"
lock item brass_key "Brass Key"
lock gallery cg festival "Festival Night"
# F65 round 2: hana is the send example's contact, invite its message.
lock contact hana "Hana"
define invite = "Meet me at the bridge when the lanterns are lit."

label start:
    "Start."
    jump bridge

label bridge:
    "The bridge."
    unlock tip lanterns
    unlock gallery cg festival
    scene cg river
    call lantern_stall
    unlock achievement garden
    jump river

# lantern_stall is the scene replay examples' scene (F36): its declaration is here so the
# unlock replay and lock replay examples name a replay.
lock replay lantern_stall "The Stall"

# garden is the unlock achievement example's achievement (F37-S3); the bridge's line gives
# it, so its dev load is free of W224.
lock achievement garden "Secret Garden" hidden
