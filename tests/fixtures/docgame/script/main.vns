# F45 TR-F45-01's test game: each StatementDoc example is placed in this file, top-level
# examples above the first line, the others right after "label start:". turns is the
# minigame example's into target (F23).
include "chapter2.vns"
define hana = Character("Hana")
default coins = 0
default turns = 0
points friendship 0 to 10
lock route river "By the River"
lock tip lanterns "Paper Lanterns"
lock item brass_key "Brass Key"

label start:
    "Start."
    jump bridge

label bridge:
    "The bridge."
    unlock tip lanterns
    call lantern_stall
    jump river
